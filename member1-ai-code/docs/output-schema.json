{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeetingTaskExtractionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks", "pending_items"],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "assignee", "deadline", "priority", "source_text", "confidence", "needs_confirmation", "confirmation_reasons"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "assignee": {"type": ["string", "null"]},
          "deadline": {"type": ["string", "null"]},
          "priority": {"enum": ["高", "中", "低", null]},
          "source_text": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["高", "中", "低"]},
          "needs_confirmation": {"type": "boolean"},
          "confirmation_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "pending_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "source_text", "reason"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "source_text": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

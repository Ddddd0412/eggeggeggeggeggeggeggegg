{
  "name": "llm-meeting-task-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "server:dev": "node --experimental-sqlite --watch server/index.js",
    "server": "node --experimental-sqlite server/index.js",
    "db:migrate": "node --experimental-sqlite server/scripts/migrate.js",
    "db:seed": "node --experimental-sqlite server/scripts/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test:backend": "node --experimental-sqlite --test server/tests/*.test.js"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
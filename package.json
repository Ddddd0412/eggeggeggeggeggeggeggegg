{
  "name": "llm-meeting-task-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:dev": "node --watch server/index.js",
    "server": "node server/index.js",
    "db:migrate": "node server/scripts/migrate.js",
    "db:seed": "node server/scripts/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "npm run test:backend",
    "test:backend": "node --test server/tests/*.test.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.2.1",
    "chart.js": "4.4.2",
    "react": "18.2.0",
    "react-chartjs-2": "5.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.22.3"
  },
  "devDependencies": {
    "vite": "5.1.6"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}

# Backend
PORT=3001
TASKFLOW_DB_PATH=./data/taskflow.sqlite
TOKEN_TTL_HOURS=24
FRONTEND_ORIGIN=http://localhost:5173
AUTO_SEED_DEMO=true

# LLM: mock mode runs without an external key.
# To use a real OpenAI-compatible endpoint, set LLM_MODE=api and fill all values.
LLM_MODE=mock
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000

# Audio transcription: mock mode works offline. API mode keeps the key on the server.
TRANSCRIPTION_MODE=mock
TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
# Leave blank to reuse LLM_API_KEY, or configure a separate server-side key.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_LANGUAGE=zh
TRANSCRIPTION_TIMEOUT_MS=60000
# The server hard-caps uploads at 25 MiB even if a larger value is configured.
TRANSCRIPTION_MAX_BYTES=26214400
TRANSCRIPTION_MOCK_TEXT=下周三前，小王整理实验数据，小李完成展示PPT，大家周五讨论测试结果。

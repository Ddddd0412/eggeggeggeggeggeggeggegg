# Backend
PORT=3001
TASKFLOW_DB_PATH=./data/taskflow.sqlite
TOKEN_TTL_HOURS=24
FRONTEND_ORIGIN=http://localhost:5173
AUTO_SEED_DEMO=true

# LLM: mock mode runs without an external key.
# To use a real OpenAI-compatible endpoint, set LLM_MODE=api and fill all values.
LLM_MODE=mock
# OpenAI Chat Completions endpoint; task extraction uses strict JSON Schema output.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
